# Copy to .env and fill in. Values below are the dev defaults; NODE_ENV=test ignores .env entirely.

# HTTP port the API listens on.
PORT=5000
# development | test | production. production hard-requires the two JWT secrets below.
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (the Vite dev server).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = boot a throwaway in-process MongoDB (no local install needed, data resets on restart).
USE_MEMORY_DB=true
# Used when USE_MEMORY_DB=false. Local mongod or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/alone_hometown

# Signs short-lived access JWTs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
# Reserved for refresh-token signing/derivation. MUST differ from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=
# Access token lifetime (s/m/h/d suffix).
ACCESS_TOKEN_TTL=15m
# Refresh token (and refresh cookie) lifetime in days.
REFRESH_TOKEN_DAYS=30
# bcrypt cost factor for password hashing (10-14 is sane; tests force 4).
BCRYPT_ROUNDS=12

# false = skip the Mojang API and derive offline-mode UUIDs locally (offline dev / tests).
MOJANG_ENABLED=true
# Abort a Mojang request after this many milliseconds.
MOJANG_TIMEOUT_MS=5000
# How long resolved Mojang lookups stay cached in memory (default 600000 = 10 min).
MOJANG_CACHE_TTL_MS=600000

# Optional cookie overrides: name/path of the auth cookies and how they are scoped.
# COOKIE_ACCESS_NAME=ah_access
# COOKIE_REFRESH_NAME=ah_refresh
# COOKIE_REFRESH_PATH=/api/auth
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Bootstrap account created by `npm run seed:superadmin` (leave empty to skip seeding).
SUPERADMIN_MC_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
